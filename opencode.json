{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "conductor",
  "subagent_depth": 1,
  "share": "manual",
  "agent": {
    "conductor": {
      "mode": "primary",
      "description": "Conversational lead that coordinates specialists while keeping the human in control."
    }
  },
  "experimental": {
    "primary_tools": [
      "question"
    ]
  },
  "provider": {
    "manifest": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Manifest",
      "options": {
        "baseURL": "https://router.lhun.net/v1"
      },
      "models": {
        "auto": {
          "name": "Manifest Auto"
        }
      }
    },
    "headroom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Headroom Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1"
      },
      "models": {
        "gpt-4o": {
          "name": "GPT-4o",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "gpt-4.1": {
          "name": "GPT-4.1",
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        }
      }
    }
  },
  "plugin": [
    "opencode-mem",
    "opencode-worktree",
    "opencode-notify"
  ],
  "mcp": {
    "mcpjungle": {
      "enabled": true,
      "type": "remote",
      "timeout": 15000,
      "url": "https://tools.lhun.net/mcp"
    },
    "chrome-devtools": {
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@1.6.0"
      ],
      "enabled": true,
      "timeout": 15000,
      "type": "local"
    },
    "headroom": {
      "type": "local",
      "command": [
        "C:\\Users\\ipoole\\.local\\bin\\headroom.EXE",
        "mcp",
        "serve"
      ],
      "enabled": true
    },
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "serena-agent",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context",
        "agent",
        "--open-web-dashboard",
        "False"
      ],
      "enabled": true
    }
  }
}
