{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "conductor",
  "experimental": {
    "subagent_depth": 1
  },
  "share": "manual",
  "permissions": [
    { "action": "*", "resource": "*", "effect": "ask" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "list", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git *", "effect": "allow" },
    { "action": "shell", "resource": "Get-Content *", "effect": "allow" },
    { "action": "shell", "resource": "Get-ChildItem *", "effect": "allow" },
    { "action": "shell", "resource": "Get-ChildItem", "effect": "allow" },
    { "action": "shell", "resource": "Select-String *", "effect": "allow" },
    { "action": "shell", "resource": "Get-Item *", "effect": "allow" },
    { "action": "shell", "resource": "Test-Path *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "type *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "ls", "effect": "allow" },
    { "action": "shell", "resource": "dir *", "effect": "allow" },
    { "action": "shell", "resource": "dir", "effect": "allow" },
    { "action": "shell", "resource": "npm *", "effect": "allow" },
    { "action": "shell", "resource": "npx *", "effect": "allow" },
    { "action": "shell", "resource": "node *", "effect": "allow" },
    { "action": "shell", "resource": "bun *", "effect": "allow" },
    { "action": "shell", "resource": "uvx *", "effect": "allow" },
    { "action": "shell", "resource": "uv *", "effect": "allow" },
    { "action": "*mcpjungle*plane-code-projects*", "resource": "*", "effect": "deny" },
    { "action": "*mcpjungle*plane-creative-projects*", "resource": "*", "effect": "deny" },
    { "action": "*mcpjungle*plane-home-improvement*", "resource": "*", "effect": "deny" },
    { "action": "*mcpjungle*plane-self-improvement*", "resource": "*", "effect": "deny" }
  ],
  "formatter": {
    "prettier": {
      "command": [
        "npx",
        "prettier",
        "--write",
        "$FILE"
      ],
      "extensions": [
        ".js",
        ".ts",
        ".jsx",
        ".tsx"
      ]
    }
  },
  "agents": {
    "conductor": {
      "mode": "primary",
      "model": "manifest/fast",
      "description": "Conversational lead that coordinates specialists while keeping the human in control."
    },
    "title": {
      "model": "manifest/micro",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" }
      ]
    },
    "summary": {
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" }
      ]
    },
    "compaction": {
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" }
      ]
    }
  },
  "providers": {
    "manifest": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Manifest",
      "settings": {
        "baseURL": "https://router.lhun.net/v1",
        "timeout": 170000,
        "headerTimeout": 160000
      },
      "models": {
        "auto": {
          "modelID": "auto",
          "name": "Manifest Auto",
          "headers": {
            "x-session-key": "opencode-main"
          }
        },
        "deep": {
          "modelID": "auto",
          "name": "Manifest Deep (reasoning)",
          "headers": {
            "x-manifest-tier": "deep",
            "x-session-key": "opencode-deep"
          }
        },
        "fast": {
          "modelID": "auto",
          "name": "Manifest Fast (coding)",
          "headers": {
            "x-manifest-tier": "fast",
            "x-session-key": "opencode-fast"
          }
        },
        "micro": {
          "modelID": "auto",
          "name": "Manifest Micro (titles/mem)",
          "headers": {
            "x-manifest-tier": "micro",
            "x-session-key": "opencode-micro"
          }
        }
      }
    },
    "headroom": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Headroom Proxy",
      "settings": {
        "baseURL": "http://127.0.0.1:8787/v1"
      },
      "models": {
        "auto": {
          "modelID": "auto",
          "name": "Manifest Auto",
          "headers": {
            "x-headroom-base-url": "https://router.lhun.net",
            "x-session-key": "opencode-main"
          }
        },
        "deep": {
          "modelID": "auto",
          "name": "Manifest Deep (reasoning)",
          "headers": {
            "x-headroom-base-url": "https://router.lhun.net",
            "x-manifest-tier": "deep",
            "x-session-key": "opencode-deep"
          }
        },
        "fast": {
          "modelID": "auto",
          "name": "Manifest Fast (coding)",
          "headers": {
            "x-headroom-base-url": "https://router.lhun.net",
            "x-manifest-tier": "fast",
            "x-session-key": "opencode-fast"
          }
        },
        "micro": {
          "modelID": "auto",
          "name": "Manifest Micro (titles/mem)",
          "headers": {
            "x-headroom-base-url": "https://router.lhun.net",
            "x-manifest-tier": "micro",
            "x-session-key": "opencode-micro"
          }
        }
      }
    }
  },
  "plugins": ["./plugins/notify"],
  "mcp": {
    "servers": {
      "mcpjungle": {
        "type": "remote",
        "url": "https://tools.lhun.net/v0/groups/engineering/mcp",
        "disabled": false,
        "timeout": {
          "catalog": 15000,
          "execution": 15000
        }
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@1.6.0"
        ],
        "disabled": false,
        "timeout": {
          "catalog": 15000,
          "execution": 15000
        }
      },
      "headroom": {
        "type": "local",
        "command": [
          "C:\\Users\\isaac\\.local\\bin\\headroom.EXE",
          "mcp",
          "serve"
        ],
        "disabled": false
      },
      "serena": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "serena-agent",
          "serena",
          "start-mcp-server",
          "--project-from-cwd",
          "--context",
          "agent",
          "--open-web-dashboard",
          "False"
        ],
        "disabled": false
      }
    }
  }
}